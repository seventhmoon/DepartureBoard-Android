<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.androidfung.departureboard" />
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/wear_app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".ui.WearDepartureBoardActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".sync.WearCompanionSyncReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.androidfung.departureboard.wear.action.SYNC_STATION_BOARDS" />
                <action android:name="com.androidfung.departureboard.wear.action.SYNC_TRACKED_DEPARTURE" />
                <action android:name="com.androidfung.departureboard.wear.action.STOP_TRACKED_DEPARTURE" />
                <action android:name="com.androidfung.departureboard.wear.action.SYNC_AI_RESPONSE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".sync.WearDataLayerListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/ekiboard" />
            </intent-filter>
        </service>
    </application>

</manifest>
