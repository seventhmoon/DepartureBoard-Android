<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_splash_logo">

    <target
        android:name="board_scale"
        android:animation="@animator/splash_board_scale" />

    <target
        android:name="live_beacon"
        android:animation="@animator/splash_beacon_pulse" />

    <target
        android:name="clock_colon"
        android:animation="@animator/splash_clock_blink" />

    <!-- Sequential Lighting Animation: Mode Icons & Rows Scale + Illuminate One-by-One -->
    <target
        android:name="row1_subway"
        android:animation="@animator/splash_row1_light" />
    <target
        android:name="row1_dimmer"
        android:animation="@animator/splash_row1_dimmer" />

    <target
        android:name="row2_train"
        android:animation="@animator/splash_row2_light" />
    <target
        android:name="row2_dimmer"
        android:animation="@animator/splash_row2_dimmer" />

    <target
        android:name="row3_bus"
        android:animation="@animator/splash_row3_light" />
    <target
        android:name="row3_dimmer"
        android:animation="@animator/splash_row3_dimmer" />

</animated-vector>
