        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_screen</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/ic_splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.DepartureBoard</item>
    </style>
</resources>
