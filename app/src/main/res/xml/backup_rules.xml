<full-backup-content>
    <!-- Only persist user saved stations, region, theme, and notification channel preferences in DataStore.
         In Android Auto Backup, specifying an <include> rule automatically excludes all other paths
         (including downloaded LiteRT-LM models, Room cache DBs, and local SharedPreferences). -->
    <include domain="file" path="datastore/station_preferences.preferences_pb" />
</full-backup-content>
