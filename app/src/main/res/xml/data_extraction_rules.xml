<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Only back up user station/theme/region DataStore preferences (excludes Glance per-widget files,
             Room cache databases, downloaded AI models, and ephemeral SharedPreferences). -->
        <include domain="file" path="datastore/station_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/station_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
