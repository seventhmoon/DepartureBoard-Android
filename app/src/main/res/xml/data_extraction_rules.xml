<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
        <exclude domain="file" path="models" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="delay_repay_receipt_log.xml" />
        <exclude domain="sharedpref" path="wear_companion_cache.xml" />
        <exclude domain="sharedpref" path="widget_config.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
        <exclude domain="file" path="models" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="wear_companion_cache.xml" />
        <exclude domain="sharedpref" path="widget_config.xml" />
    </device-transfer>
</data-extraction-rules>
